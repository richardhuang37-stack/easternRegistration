@startuml
skinparam classAttributeIconSize 0
hide circle

class EasternSchedule {
  -{static} BASE: String = "https://reg-prod.ec.easternct.edu/StudentRegistrationSsb"
  -{final} term: String
  -{final} cookieManager: CookieManager
  -{final} client: HttpClient
  --
  +EasternSchedule()
  +getTerm(): String
  -retrieveTerms(): String
  -parseTerms(content: String): ArrayList<Term>
  -parseCourses(content: String): ArrayList<Course>
  +getAvailableTerms(): ArrayList<Term>
  -postTerm(): String
  -createCacheFile(subject: String): Path
  -cacheCourses(subject: String): void
  +queryCourseBySubject(subject: String): ArrayList<Course>
}

class MainMenu {
  +displayCoursesBySubject(schedule: EasternSchedule, subject: String): void
  +displayCoursesBySubjectAndNumber(schedule: EasternSchedule, subject: String, courseNumber: String): void
  +displayStudentSchedule(student: Student): void
  +addCourseToStudent(schedule: EasternSchedule, student: Student, subject: String, courseNumber: String, sectionChoice: int): boolean
  +dropCourseFromStudent(student: Student, courseChoice: int): boolean
  +open(): void
  -displayCourses(courses: ArrayList<Course>, searchDescription: String): void
  -displayCourse(course: Course): void
  -courseSummary(course: Course): String
  -displayCoursesForDrop(student: Student): void
  -{static} formatCreditRange(low: Double, high: Double): String
  -{static} formatCredit(credits: Double): String
  -{static} decodeHtmlEntities(text: String): String
  -{static} coursesBySubjectAndNumber(schedule: EasternSchedule, subject: String, courseNumber: String): ArrayList<Course>
}

record Course {
  -id : String
  -subject: String
  -courseNumber: String
  -meetingsFaculty: List<MeetingFaculty>
  -courseTitle: String
  -creditHours: String
  -sequenceNumber: String
  -creditHourLow: Double
  -creditHourHigh: Double
  -courseReferenceNumber: String
  -maximumEnrollment: Integer
  -enrollment: Integer
  -seatsAvailable: Integer
  --
  +Course(id: String, subject: String, courseNumber: String, meetingsFaculty: List<MeetingFaculty>)
  +Course(id: String, subject: String, courseNumber: String, meetingsFaculty: List<MeetingFaculty>, courseTitle: String, creditHours: String, sequenceNumber: String, creditHourLow: Double, creditHourHigh: Double)
  +toString(): String
}

record MeetingFaculty {
  -meetingTime: MeetingTime
  --
  +toString(): String
}

record MeetingTime {
  -monday: boolean
  -tuesday: boolean
  -wednesday: boolean
  -thursday: boolean
  -friday: boolean
  -saturday: boolean
  -sunday: boolean
  -beginTime: String
  -endTime: String
  --
  +toString(): String
  -{static} appendDay(days: StringBuilder, abbreviation: String, occurs: boolean): void
  -{static} formatTimeRange(begin: String, end: String): String
  -{static} periodOf(time: String): String
  -{static} normalizeTime(time: String): String
}

record Term {
  -code: String
  -description: String
}

class Student {
  {static} +MAX_CREDITS: int = 17
  -id: String
  -firstName: String
  -lastName: String
  -courses: ArrayList<Course>
  --
  +Student(id: String, firstName: String, lastName: String)
  +getId(): String
  +getFirstName(): String
  +getLastName(): String
  +getCourses(): List<Course>
  +getTotalCredits(): double
  +addCourse(course: Course): boolean
  +addCourses(courses: Collection<Course>): boolean
  +dropCourse(course: Course): boolean
  +dropCourses(courses: Collection<Course>): int
  +dropAllCourses(): void
  -{static} isFull(course: Course): boolean
  -{static} containsCourse(existing: List<Course>, course: Course): boolean
  -{static} sameCourse(first: Course, second: Course): boolean
  -{static} notBlank(value: String): boolean
  -{static} totalCredits(registeredCourses: List<Course>): double
  -{static} courseCredits(course: Course): double
  -{static} hasTimeConflict(first: Course, second: Course): boolean
  -{static} meetingsConflict(first: MeetingTime, second: MeetingTime): boolean
  -{static} shareDay(first: MeetingTime, second: MeetingTime): boolean
  -{static} parseTime(value: String): LocalTime
}

'Aggregation and composition
MeetingFaculty "1" o-- "1" MeetingTime : has a >
Course "1" 0-- "0*" MeetingFaculty: has a >
Student "1" o-- "0*" Course : registers for >

'Dependencies
EasternSchedule ..> Term : uses
EasternSchedule ..> Course : uses
MainMenu ..> EasternSchedule : queries
MainMenu ..> Course : displays
MainMenu ..> Student : manages registration
Student ..> Course : registers

@enduml